  "findings": [
    {
      "id": "AUTH-DATA-01",
      "severity": "P2",
      "file": "server/access/service.mjs",
      "line": 282,
      "title": "Expired access renewal is committed but reported unavailable when time advances during SQL",
      "trigger": "An authenticated administrator renews a finite active client whose access has expired; Date.now advances at least 1 ms between administration() and the store post-lock clock refresh.",
      "impact": "The database commits the correct renewal, then the service throws AUTH_UNAVAILABLE and HTTP maps it to 503. The administrator sees failure despite the extension. A retry with the same expectedExpiresAt is refused by the persisted CAS, leaving the result ambiguous until refreshing the list. This is not an authorization bypass or duplicate extension.",
      "repro": {
        "command": "node /workspace/scratch/bb431be72395/audit2-182/auth_data_security/repro-renew-expired-clock.mjs",
        "method": "Unchanged real createAccessService + createAccessStore with an in-memory SQL adapter injecting 1 ms at the target-row lock; real locked auth, CAS, expiry calculation and transaction control execute. No external SQL/server is contacted.",
        "result": {
          "scenario": "expired renewal crosses 1ms at target lock",
          "clockBefore": 1792700000000,
          "clockAfter": 1792700000001,
          "serviceExpectedExpiry": 1792786400000,
          "storedExpiry": 1792786400001,
          "commits": 1,
          "updateCount": 1,
          "outwardError": "AUTH_UNAVAILABLE",
          "mappedHttpStatus": 503,
          "trace": [
            "begin",
            "target_lock_elapsed_1ms",
            "expiry_updated",
            "commit"
          ],
          "syntheticOnly": true
        }
      },
      "evidence": [
        "server/access/service.mjs:273-282 calculates expectedTarget before await store.renewClient, then requires exact millisecond equality after the committed call.",
        "server/access/store.mjs:474-495 refreshes now after locks and derives max(now,currentExpiry)+days before UPDATE/commit.",
        "server/index.mjs:260,396,400-401 wires Date.now/shared advancing clock to both production factories.",
        "tests/access-service.test.mjs:36-39 mock uses options.now rather than actual post-lock time; lines 276-296 advance only during quota waits.",
        "tests/access-flow.integration.test.mjs:279-309 uses a fixed injected clock.",
        "repro-renew-expired-clock.mjs",
        "repro-renew-expired-clock.json"
      ],
      "confidence": "high",
      "recommendation": "Validate the expiry against the effective post-lock mutation instant (for example return that instant from the store), while retaining exact expectedExpiresAt CAS, actor recheck and bounded horizon. Add a targeted advancing-clock regression; no SQL migration is needed."
    }
  ],
  "crossReviewNotes": [
    {
      "owner": "/root/audit2_messaging_media",
      "status": "confirmed_source_extension_of_same_finding",
      "topic": "Late unauthorized response clears a replacement session cookie",
      "evidence": [
        "server/auth/http.mjs:210-214",
        "server/access/http.mjs:210-214",
        "server/auth/store.mjs:76-105",
        "server/access/store.mjs:347-365"
      ],
      "detail": "Both auth and access handlers emit Max-Age=0 for stale A after awaited session lookup; a login B in another tab can have set the cookie before A response. Messaging/media owns the one shared finding and reproduction. Privacy and closure handlers intentionally omit cookie deletion on late 401. Do not duplicate as another auth finding."
    },
    {
      "owner": "/root/audit2_domains",
      "status": "cross_check_sent_owner_reproducing",
      "topic": "Reset mail claim retains a pre-lock timestamp",
      "evidence": [
        "server/reset/mail-store.mjs:35-87"
      ],
      "detail": "claim accepts caller now and does not refresh it across pool/user/auth/reset/job waits. Domain owner confirmed worker/transport do not check expiry before delivery and is preparing a single verification+reset reproduction. Any confirmed finding belongs to that owner, not this report."
    },
    {
      "owner": "/root/audit2_frontend_messaging",
      "status": "expected_fail_closed_server_contract",
      "topic": "Erasure changes broadcast retry fingerprint",
      "evidence": [
        "server/data/erasure-store.mjs:98-116",
        "server/data/erasure-store.mjs:136-154"
      ],
      "detail": "Explicitly designed to preserve conflict for an old retry rather than recreate a permanently removed recipient. A conflict is not itself a new backend finding. Frontend owner may independently qualify inability to reconcile an uncertain operation."
    }
  ],
